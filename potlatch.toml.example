# Potlatch Configuration File
# Configure agents under [agent.<name>] sections. Only agents with a section are started.

# GitLab repository URL (HTTPS). Required by GitLab agents (worker, reviewer, pmo, ops).
gitlab_repo = "https://gitlab.com/group/project"

# Optional: only process issues/MRs that include this label (exact name).
# scope_label = "potlatch"

# ACP client profiles are defined under [acp.<vendor>] sections. The `<vendor>`
# part of the model URI (`acp://<vendor>/<model>`) selects which profile is used.
#
# Potlatch harness (built-in, talks directly to OpenAI-compatible endpoints).
# Two config styles are supported:
#
# 1. Single endpoint via top-level fields:
# [acp.potlatch]
# base_url = "http://localhost:11434/v1"
# api_key = "EMPTY"
# acp_command = ["potlatch", "harness"]
# env = [
#   "POTLATCH_BASE_URL={base_url}",
#   "POTLATCH_API_KEY={api_key}",
# ]
#
# 2. Multiple endpoints selected by model name. The `endpoints` table maps
#    each model name (the last path segment of the model URI, with any
#    `?query` stripped) to its own fields. The `{field}` placeholders in
#    `env` are resolved from the matching endpoint entry:
# [acp.potlatch]
# acp_command = ["potlatch", "harness"]
# endpoints = [
#   { model = "model1",       endpoint = "http://prod-model1.example", key = "EMPTY" },
#   { model = "model2-flash", endpoint = "http://prod-model2.example", key = "EMPTY" },
# ]
# env = [
#   "POTLATCH_BASE_URL={endpoint}",
#   "POTLATCH_API_KEY={key}",
# ]

[acp.cursor]
acp_command = ["agent", "acp"]

[agent.worker]
model = "acp://cursor/claude-sonnet-4-5"
poll_interval = "1m"
instances = 1

[agent.reviewer]
model = "acp://cursor/claude-sonnet-4-5"
poll_interval = "2m"
instances = 1
merge_when_approved = true

[agent.pmo]
model = "acp://cursor/claude-sonnet-4-5"
poll_interval = "3m"
instances = 1

[agent.ops]
model = "acp://cursor/claude-sonnet-4-5"
# Single-instance only; omit [agent.ops] entirely to disable.
poll_interval = "10m"
log_window_interval = "2h"
logs = [
  { ssh_user = "deploy", ssh_host = "prod.example.com", log_path = "/var/log/app/app.log" },
  # { ssh_user = "deploy", ssh_host = "worker.example.com", log_path = "/var/log/app/worker.log" },
  # Grafana Elasticsearch sources query the same configured window as SSH sources.
  # Keep this local config uncommitted because username/password are literal credentials.
  # `filter` accepts raw Elasticsearch query DSL or a Lucene query string.
  # { type = "grafana", url = "https://grafana.example.com", datasource_uid = "elastic-uid", index = "application-logs", org_id = 1, username = "ops", password = "replace-me", filter = '{"term":{"service.name":"api"}}' },
]

[agent.qa]
# QA agent: runs regression tests and security analysis on branch commits.
# Only runs when qa.md exists in the repo root. Omit [agent.qa] to disable.
model = "acp://cursor/claude-sonnet-4-5"
poll_interval = "5m"
instances = 1
branches = ["main"]

[agent.web]
max_results = 8

[agent.clerk]
# Clerk agent: maintains durable project memory as plain markdown.
# Requires a model for reorganization and deduplication after each write.
model = "acp://cursor/claude-sonnet-4-5"
