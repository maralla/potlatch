# Potlatch Configuration File
# Configure agents under [agent.<name>] sections. Only agents with a section are started.

# Repository URL (HTTPS or SSH). Required by GitLab/GitHub agents (worker, reviewer, pmo, ops).
# Supports GitLab and GitHub. Auto-detected from the URL hostname.
# Accepted config keys: `repo_url` (preferred) or `gitlab_repo` (legacy alias).
repo_url = "https://gitlab.com/group/project"
# For GitHub instead: repo_url = "https://github.com/owner/project"

# Sandbox (sandal) settings. With an [agent.sandal] section the sandal
# agent maintains one sandbox VM per agent session and reuses it across
# that session's shell calls; its `shell` tool OVERRIDES the built-in
# host shell tool for every session, so the sandbox is the only shell
# there is. A VM nobody calls on for the idle timeout is closed with its
# whole overlay. Omit the section entirely to keep the built-in host
# shell tool.
#[agent.sandal]
# Layer files loaded into the session VMs (see the sandal project:
# toolchain images built with `sandal-export` inside a sandbox VM).
# Paths are relative to this config file's directory — the directory
# that holds potlatch.toml — because the agents run from a different
# working directory (their worktrees) that must never influence how a
# configured relative path resolves.
#layers = ["go.layer"]
# Persistent host directories mapped into the session VMs, as `host:guest`
# specs. Each VM boots fresh, so without a host-backed cache every build
# starts cold; the go module/build caches are the ones that matter:
# `~` expands per side — the host home on the host side, /root (the
# sandbox guest always runs as root) on the guest side — so the specs
# below put the guest's default cache paths on the host's caches.
#shared = [
#  "~/go/pkg:~/go/pkg",
#  "~/.cache/go-build:~/.cache/go-build",
#]
# VM memory cap in MB. Defaults to 2048 when layers are configured. The
# cap no longer sizes the footprint: the sandbox boots a small RAM floor
# and hot-adds memory on demand, so idle cost is flat regardless of this
# value and a workload only brings online what it actually touches. The
# cap bounds runaway allocations; set `memory` explicitly for a heavier
# toolchain (rustc, CGO, large links).
#memory = 2048
# Writable overlay disk in MB. Defaults to 16384 when layers are
# configured: package downloads land on the overlay, whose size without
# this is the layer data plus 16 MB — real dependency fetches fill that
# within minutes.
#disk = 16384
# Idle timeout in seconds for a session VM nobody has called the shell
# tool on; the VM is closed with its whole overlay when it passes.
# Defaults to 1800 (30 minutes).
#idle_timeout_secs = 1800

# Optional: only process issues/MRs that include this label (exact name).
# scope_label = "potlatch"

# ACP client profiles are defined under [acp.<vendor>] sections. The `<vendor>`
# part of the model URI (`acp://<vendor>/<model>`) selects which profile is used.
#
# Potlatch harness (built-in, talks directly to OpenAI-compatible endpoints).
# Three config styles are supported:
#
# 1. Single endpoint via top-level fields:
# [acp.potlatch]
# base_url = "http://localhost:11434/v1"
# api_key = "EMPTY"
# acp_command = ["potlatch", "harness"]
# env = [
#   "POTLATCH_BASE_URL={base_url}",
#   "POTLATCH_API_KEY={api_key}",
# ]
#
# 2. Multiple endpoints selected by model name. The `endpoints` table maps
#    each model name (the last path segment of the model URI, with any
#    `?query` stripped) to its own fields. The `{field}` placeholders in
#    `env` are resolved from the matching endpoint entry. An entry may also
#    declare an `alias`: it is then addressed as `acp://<vendor>/<alias>`
#    while the backend still receives the real `model` name — one model can
#    be exposed under several names, possibly through different endpoints.
#    An aliased entry is addressed only by its alias; aliases and model
#    names must be unique within the profile.
#
#    API protocol: endpoints speaking the Anthropic Messages API
#    (`/v1/messages`, x-api-key auth) are supported alongside
#    OpenAI-compatible ones. Select the protocol per endpoint with the
#    `api` field (`api = "anthropic"`, `api = "responses"`, or
#    `api = "openai"` — the default is openai); it is forwarded to the
#    harness as POTLATCH_API automatically, or reference it explicitly
#    with `POTLATCH_API={api}`. A profile-level `api` applies to every
#    endpoint that doesn't declare one. On Anthropic endpoints the
#    `effort` query param maps to extended thinking (keywords
#    low/medium/high/max or a numeric literal set the budget); on
#    Responses endpoints it maps to the reasoning effort parameter.
#
#    `context_tokens` (optional) sets the session context budget for the
#    endpoint — forwarded to the harness as POTLATCH_CONTEXT_TOKENS.
#    Accepts plain or human-friendly counts: "120000", "120K", "1M".
#    Compaction triggers at 60% of the budget, so a smaller value keeps
#    requests well below a gateway's real capacity. Set it when a backend
#    misbehaves on large payloads (observed: stalls on requests near the
#    model's nominal size). Default: 200000.
# [acp.potlatch]
# acp_command = ["potlatch", "harness"]
# endpoints = [
#   { model = "model1", alias = "model-x", endpoint = "http://endpoint1.example", key = "EMPTY", context_tokens = "120000" },
#   { model = "model1", alias = "model-y", endpoint = "http://endpoint2.example", key = "EMPTY" },
# ]
# env = [
#   "POTLATCH_BASE_URL={endpoint}",
#   "POTLATCH_API_KEY={key}",
# ]
#
# 3. Dynamic endpoint headers via an auth-provider command. An endpoint may
#    declare `auth_provider` with an arbitrary command that must follow one
#    output contract: print progress (OAuth callback URLs, "open this link"
#    notices) to stderr, then print exactly one JSON document as the final
#    stdout line:
#      {"expiration": 1735689600, "headers": {"Authorization": "Bearer ..."}}
#    `expiration` is a Unix timestamp (seconds; ms and RFC 3339 also accepted)
#    after which the command is re-run. `headers` are applied to every request
#    to the endpoint and cached until the expiration, so the interactive part
#    of an OAuth dance only happens when credentials actually need refreshing.
#    Anything the command prints before the final document is surfaced to the
#    user in the UI (never treated as the final output).
#    The command runs with the directory of this config file as its working
#    directory, and a bare command name is also resolved there first — a
#    script placed next to this file runs as `auth-tool.py` or `./auth-tool.py`.
#    It also receives `POTLATCH_AUTH_STATE_DIR`: an endpoint-scoped directory
#    under ~/.potlatch/endpoints/auth-provider/ for the script's own token
#    cache, so two endpoints never share an auth.json.

#    Concurrent agent processes are single-flighted: one runs the command,
#    the others hold and reuse its published result.
# endpoints = [
#   { model = "model1", endpoint = "http://endpoint1.example", auth_provider = "auth-helper --login" },
# ]

[acp.cursor]
acp_command = ["agent", "acp"]

[agent.worker]
model = "acp://cursor/claude-sonnet-4-5"
poll_interval = "1m"
instances = 1
# Optional SSH hosts this agent may reach through its `ssh` tool (run a
# command on a listed host). Any fleet agent (worker, reviewer, pmo, qa) can
# configure its own hosts; the tool is offered only to that agent's own
# sessions and executes in its own process. Only `hostname` is required;
# without `user` ssh connects as its default, and without `identity_file`
# ssh's own configuration authenticates. Omit entirely to not offer the
# tool. Hostnames and users must not contain whitespace or start with '-';
# `~/` in identity_file expands against $HOME.
# ssh = [
#   { hostname = "build.example.com", user = "ci", identity_file = "~/.ssh/ci_ed25519" },
#   { hostname = "db.example.com", user = "admin" },
#   { hostname = "cache.example.com" },
# ]

[agent.reviewer]
model = "acp://cursor/claude-sonnet-4-5"
poll_interval = "2m"
instances = 1
merge_when_approved = true

[agent.pmo]
model = "acp://cursor/claude-sonnet-4-5"
poll_interval = "3m"
instances = 1

[agent.ops]
model = "acp://cursor/claude-sonnet-4-5"
# Single-instance only; omit [agent.ops] entirely to disable.
poll_interval = "10m"
log_window_interval = "2h"
logs = [
  { ssh_user = "deploy", ssh_host = "prod.example.com", log_path = "/var/log/app/app.log" },
  # { ssh_user = "deploy", ssh_host = "worker.example.com", log_path = "/var/log/app/worker.log" },
  # Grafana Elasticsearch sources query the same configured window as SSH sources.
  # Keep this local config uncommitted because username/password are literal credentials.
  # `filter` accepts raw Elasticsearch query DSL or a Lucene query string.
  # { type = "grafana", url = "https://grafana.example.com", datasource_uid = "elastic-uid", index = "application-logs", org_id = 1, username = "ops", password = "replace-me", filter = '{"term":{"service.name":"api"}}' },
]

# GRAFANA METRICS (optional): the datasources behind the ops agent's
# `grafana_query` tool, configured alongside `logs` above. When configured,
# the tool is published on the cross-agent bus; other agents use it to read
# metric time series (rates, latencies, error counts, resource usage).
# Metrics only — the tool cannot read logs or dashboards. Each entry's
# `name` (what the model passes as `datasource`) and `description` (what it
# is for) are published in the tool schema. `datasource_type` defaults to
# "prometheus". Keep credentials in the uncommitted local config.
# grafana = [
#   { name = "metrics", description = "Primary metrics datasource.", url = "https://grafana.example.com", datasource_uid = "prom-uid", datasource_type = "prometheus", org_id = 1, username = "ops", password = "replace-me" },
#   { name = "edge", description = "Edge node metrics.", url = "https://grafana.example.com", datasource_uid = "edge-uid", datasource_type = "prometheus", org_id = 1, username = "ops", password = "replace-me" },
# ]

[agent.qa]
# QA agent: monitors the configured branches for new commits and runs
# regression testing and security analysis against the running system.
# `qa.md` at the repo root is optional project-specific QA instructions.
# Omit [agent.qa] to disable.
model = "acp://cursor/claude-sonnet-4-5"
poll_interval = "5m"
instances = 1
branches = ["main"]

[agent.web]
max_results = 8

[agent.clerk]
# Clerk agent: maintains durable project memory as plain markdown.
# Requires a model for reorganization and deduplication after each write.
model = "acp://cursor/claude-sonnet-4-5"

[agent.subagent]
# Subagent agent: exposes the `subagent` tool to other agents through the
# bus and runs one ACP client per vendor found in `provided_models` — the
# platform's own `potlatch harness` binary for the potlatch vendor, the
# vendor profile's `acp_command` for others. `provided_models` are FULL
# model URIs: the list is published to callers' context (every spawn must
# pass one), and the models of each vendor must belong to that vendor
# profile's same endpoint. `max_live_subagents` optionally caps how many
# subagents may be live at once — omit it for no cap. Subagent transcripts
# are written under .potlatch/subagent/transcripts/ (potlatch vendor only).
provided_models = ["acp://potlatch/model1?effort=high"]
# max_live_subagents = 8
